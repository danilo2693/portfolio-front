generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String?   @map("password_hash")
  role         String    @default("admin")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt BigInt   @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model Profile {
  id             String   @id @default("default")
  name           String   @default("Danilo")
  email          String   @default("")
  phone          String?
  summary        Json?    // String or object { en: "...", es: "..." }
  description    Json?    // String or object { en: "...", es: "..." }
  avatarUrl      String?  @map("avatar_url")
  avatarPublicId String?  @map("avatar_public_id")
  cvUrl          String?  @map("cv_url")
  cvPublicId     String?  @map("cv_public_id")
  links          Json?    // Array of { title: string, url: string, icon: string }
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Experience {
  id          String   @id @default(uuid())
  title       String
  companyName String   @map("company_name")
  periodTime  String   @map("period_time")
  description Json?    // String, array or localized { en, es }
  orderIndex  Int      @default(0) @map("order_index")
  enabled     Boolean  @default(true)
  locale      String   @default("all") // "all", "en", "es"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("experiences")
}

model Project {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description Json?          // String, array or localized { en, es }
  siteUrl     String?        @map("site_url")
  githubUrl   String?        @map("github_url")
  stack       Json?          // Array of { title: string, icon: string }
  featured    Boolean        @default(false)
  enabled     Boolean        @default(true)
  orderIndex  Int            @default(0) @map("order_index")
  locale      String         @default("all") // "all", "en", "es"
  photos      ProjectPhoto[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectPhoto {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url             String
  publicId        String?  @map("public_id")
  alternativeText String?  @map("alternative_text")
  orderIndex      Int      @default(0) @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("project_photos")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
