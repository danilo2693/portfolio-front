---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { prisma } from '../../lib/prisma';

export const prerender = false;

// Metrics
const [totalProjects, activeProjects, totalExperiences, unreadMessages, recentMessages] = await Promise.all([
  prisma.project.count(),
  prisma.project.count({ where: { enabled: true } }),
  prisma.experience.count(),
  prisma.contactMessage.count({ where: { isRead: false } }),
  prisma.contactMessage.findMany({
    orderBy: { createdAt: 'desc' },
    take: 5,
  }),
]);
---

<AdminLayout title="Dashboard Principal" currentPath="/admin">
  <div class="space-y-8">
    
    <!-- Welcome banner -->
    <div class="bg-gradient-to-r from-blue-600/10 via-indigo-600/10 to-blue-500/5 border border-blue-500/20 rounded-3xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
          Panel de Control
        </span>
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
          Bienvenido a la administración de tu Portafolio
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-sm max-w-xl font-light">
          Gestiona tus proyectos, sube capturas directamente a Cloudinary, actualiza tu trayectoria laboral y revisa las consultas enviadas a través del formulario de contacto.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="/admin/projects"
          class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs rounded-xl shadow-sm transition active:scale-95 flex items-center gap-2"
        >
          <span>+ Gestionar Proyectos</span>
        </a>
        <a
          href="/admin/profile"
          class="px-5 py-2.5 bg-white dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-750 text-gray-800 dark:text-gray-200 border border-gray-200 dark:border-gray-700 font-medium text-xs rounded-xl shadow-xs transition"
        >
          <span>Editar Perfil & Bio</span>
        </a>
      </div>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
      <!-- Total Projects -->
      <div class="bg-white dark:bg-[#161b22] p-5 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-xs space-y-2">
        <span class="text-xs text-gray-500 dark:text-gray-400 font-medium block">Total Proyectos</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-bold text-gray-900 dark:text-white">
            {totalProjects}
          </span>
          <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full">
            {activeProjects} visibles
          </span>
        </div>
      </div>

      <!-- Experiences -->
      <div class="bg-white dark:bg-[#161b22] p-5 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-xs space-y-2">
        <span class="text-xs text-gray-500 dark:text-gray-400 font-medium block">Experiencia Laboral</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-bold text-gray-900 dark:text-white">
            {totalExperiences}
          </span>
          <a href="/admin/experiences" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
            Gestionar →
          </a>
        </div>
      </div>

      <!-- Unread Messages -->
      <div class="bg-white dark:bg-[#161b22] p-5 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-xs space-y-2">
        <span class="text-xs text-gray-500 dark:text-gray-400 font-medium block">Mensajes Recibidos</span>
        <div class="flex items-baseline justify-between">
          <span class="text-3xl font-bold text-gray-900 dark:text-white">
            {unreadMessages}
          </span>
          <span class={`text-xs font-medium px-2.5 py-0.5 rounded-full ${
            unreadMessages > 0
              ? 'text-amber-600 dark:text-amber-400 bg-amber-500/10 animate-pulse'
              : 'text-gray-400 bg-gray-100 dark:bg-gray-800'
          }`}>
            {unreadMessages > 0 ? 'Nuevos' : 'Al día'}
          </span>
        </div>
      </div>
    </div>

    <!-- Recent Messages Section -->
    <div class="bg-white dark:bg-[#161b22] rounded-3xl border border-gray-200 dark:border-gray-800 p-6 shadow-xs space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-bold text-lg text-gray-900 dark:text-white">
            Últimos Mensajes de Contacto
          </h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">
            Consultas enviadas por visitantes desde el formulario del portafolio
          </p>
        </div>
        <a href="/admin/messages" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
          Ver Bandeja Completa →
        </a>
      </div>

      {recentMessages.length === 0 ? (
        <div class="text-center py-8 text-gray-400 text-sm">
          No hay mensajes de contacto registrados todavía.
        </div>
      ) : (
        <div class="divide-y divide-gray-100 dark:divide-gray-800">
          {recentMessages.map((msg) => (
            <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold text-gray-900 dark:text-white">
                    {msg.name}
                  </span>
                  <span class="text-xs text-gray-400">({msg.email})</span>
                  {!msg.isRead && (
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-500/10 text-blue-600 border border-blue-500/20">
                      Nuevo
                    </span>
                  )}
                </div>
                <p class="text-xs text-gray-600 dark:text-gray-300 line-clamp-1 italic">
                  "{msg.message}"
                </p>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                <a
                  href={`mailto:${msg.email}?subject=Contacto Portafolio`}
                  class="px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 transition"
                >
                  Responder
                </a>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

  </div>
</AdminLayout>
